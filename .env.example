# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Required for scheduled reminders, public mutation rate limits, and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional OpenAI-compatible provider. AI routes degrade to search without these.
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Optional transactional email provider.
RESEND_API_KEY=
EMAIL_FROM=Praxis <reminders@example.com>

# Comma-separated admin user UUIDs for moderation.
ADMIN_USER_IDS=

# Optional: two verified, onboarded test accounts for the full Playwright golden path.
E2E_EMAIL=
E2E_PASSWORD=
E2E_SECOND_EMAIL=
E2E_SECOND_PASSWORD=
