# Praxis environment variables — Supabase foundation (Milestone 3).
#
# Copy this file to `.env.local` and fill in your project's browser-safe values:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. Never commit real credentials.
# The existing pages build and render without these variables; they are only
# required when code actually creates a Supabase client (and for `npm run
# supabase:check`).

# Supabase project URL (Supabase dashboard → Project Settings → Data API,
# or the project's Connect dialog).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key — the browser-safe public key
# (Supabase dashboard → Project Settings → API Keys).
# NEVER put a service-role key, secret key, or database password in a
# NEXT_PUBLIC_* variable. This milestone does not use privileged keys at all.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
